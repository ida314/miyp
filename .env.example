# Required
OPENAI_API_KEY=sk-your-key-here
PORT=3000

# CORS — set to your production domain to restrict API access
# Leave unset in development (allows all origins)
# CORS_ORIGIN=https://monkinyourpocket.com

# Rate limiting (defaults shown)
# RATE_LIMIT_PER_MIN=10
# RATE_LIMIT_PER_DAY=100

# Input validation (default shown)
# MAX_MESSAGE_LENGTH=1000

# Logging: debug | info | warn | error (default: info)
# LOG_LEVEL=info
